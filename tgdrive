def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        cmd_help()
        sys.exit(0)

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd == "remote":
        cmd_remote(args)
    elif cmd == "init":
        cmd_init(args)
    elif cmd == "add":
        cmd_add(args)
    elif cmd == "status":
        cmd_status(args)
    elif cmd == "push":
        cmd_push(args)
    elif cmd == "pull":
        cmd_pull(args)
    elif cmd == "ls":
        cmd_ls(args)
    elif cmd == "share":
        cmd_share(args)
    elif cmd == "info":
        cmd_info(args)
    else:
        log_error(f"Unknown command: '{cmd}'. Run 'tgdrive help' for usage.")

if __name__ == "__main__":
    main()
