# ========================================================
# TG Cloud Drive Configuration
# ========================================================

# 1. Telegram API Credentials
# Obtain these from https://my.telegram.org/apps
API_ID="YOUR_API_ID"
API_HASH="YOUR_API_HASH"

# 2. Telegram Bot Token
# Create a bot via @BotFather on Telegram (https://t.me/BotFather)
BOT_TOKEN="YOUR_BOT_TOKEN"

# 3. Storage Channel ID
# Create a private Telegram channel, add your bot as an Administrator with full permissions.
# Forward any message from the channel to @userinfobot or @JsonDumpBot to get the channel ID (starts with -100).
CHANNEL_ID="-100xxxxxxxxxx"

# 4. Web Dashboard & CLI Admin Password
# Set a strong password for web dashboard and CLI remote access.
ADMIN_PASS="ChangeThisToAStrongPassword"

# 5. Server Port
PORT="3005"

# 6. Public Domain / Base URL (Used for generating streaming and share links)
BASE_URL="https://drive.yourdomain.com"

# 7. (Optional) Allowed Telegram Users (Comma-separated Telegram User IDs or usernames)
# Leave empty to allow any user who chats with the bot.
ALLOWED_TELEGRAM_USERS=""
